PORT=3000
NODE_ENV=development

# MongoDB - "Veritabanı bağlantısı yok" hatası için:
# 1) Ücretsiz Atlas: https://www.mongodb.com/cloud/atlas/register
# 2) Cluster oluştur, Connect → connection string kopyala
# 3) Aşağıdaki MONGODB_URI satırını kendi linkinizle değiştirin (KULLANICI ve SIFRE'yi yazın)
# Yerel MongoDB (bilgisayarda kuruluysa):
# MONGODB_URI=mongodb://127.0.0.1:27017/48app
# Atlas (önerilen):
MONGODB_URI=mongodb+srv://KULLANICI:SIFRE@cluster0.xxxxx.mongodb.net/48app?retryWrites=true&w=majority

# Nöbetçi eczane (isteğe bağlı). Boş bırakılırsa açık kaynak kullanılır.
# ECZANE_API_KEY=eczane_api_xxxxxxxxxxxxx

# Yöresel rezervasyon bedeli — iyzico (kart bilgisi uygulamada tutulmaz)
# Sandbox: https://sandbox-merchant.iyzipay.com
# Canlı: https://merchant.iyzipay.com
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
# IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# PUBLIC_API_BASE_URL=https://mobile-app-wp3h.onrender.com
